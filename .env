# ─── Veritabanı ───────────────────────────────────────────────────────────────
# asyncpg bağlantı formatı: postgresql://kullanici:sifre@host:port/veritabani
VERITABANI_URL=postgresql://ozgur.onder:BZrf5399!@localhost:5432/multitenant_auth

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Oturum tokenlarını imzalamak için kullanılan gizli anahtar.
# Üretimde: python -c "import secrets; print(secrets.token_hex(32))"  kodu terminale yazılarak üretilmiştir.
JWT_GIZLI_ANAHTAR=b601db0b1b8786a84048f6a1421ae1a05e95693053abf0939b1edb7ee2441827

# JWT oturum süresi (dakika) — 480 = 8 saat
JWT_SURE_DAKIKA=480

# ─── NiceGUI ──────────────────────────────────────────────────────────────────
# Kullanıcı depolama (storage.user) şifreleme anahtarı.
# Üretimde: python -c "import secrets; print(secrets.token_hex(32))" ile üret.
ENCRYPTION_KEY=b601db0b1b8786a84048f6a1421ae1a05e95693053abf0939b1edb7ee2441827

POSTGRES_DB=multitenant_auth
POSTGRES_USER=ozgur.onder
POSTGRES_SIFRE=BZrf5399!