# Veritabanı bağlantı adresi (asyncpg formatı)
VERITABANI_URL=postgresql://postgres:sifre@localhost:5432/multitenant_auth

# JWT imzalama anahtarı — üretimde mutlaka rastgele uzun bir değer kullan
JWT_GIZLI_ANAHTAR=gizli_anahtari_buraya_yaz_degistir

# JWT oturum süresi (dakika) — varsayılan 480 = 8 saat
JWT_SURE_DAKIKA=480

# NiceGUI kullanıcı depolama şifreleme anahtarı
ENCRYPTION_KEY=sifrele_bunu_da_degistir
